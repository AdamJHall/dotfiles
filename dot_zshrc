# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

source ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting-catppuccin/themes/catppuccin_macchiato-zsh-syntax-highlighting.zsh

# Active Plugins
plugins=(fzf-tab zsh-autosuggestions zsh-syntax-highlighting zsh-fzf-history-search)

# Extended Completions
fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

# Activate oh-my-zsh
source $ZSH/oh-my-zsh.sh

# User configuration
## Plugin Configuration 
# zsh-fzf-history-search
export ZSH_FZF_HISTORY_SEARCH_EVENT_NUMBERS=0
export ZSH_FZF_HISTORY_SEARCH_DATES_IN_SEARCH=0
export ZSH_FZF_HISTORY_SEARCH_REMOVE_DUPLICATES=1
export ZSH_FZF_HISTORY_SEARCH_FZF_EXTRA_ARGS="--reverse --border --height=50%"

## fzf defaults
export FORGIT_FZF_DEFAULT_OPTS="--height=50%"

# fzf-tab tmux
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# Starship Prompt
eval "$(starship init zsh)"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
export PATH="$HOME/.local/bin:$PATH"
